{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.3.5",
  "default_locale": "ja",
  "description": "__MSG_appDescription__",
  "homepage_url": "https://github.com/delacunaworks/fresh-chat-keeper",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://fresh-chat-keeper-proxy.playnicelab.workers.dev/*",
    "https://fresh-chat-keeper-api.playnicelab.workers.dev/*",
    "http://localhost:8788/*",
    "http://127.0.0.1:8788/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__"
  }
}
