{
  "name": "@fresh-chat-keeper/transcribe-vod",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "運営用 CLI: アーカイブ VOD を yt-dlp → Scribe v2 で転写し AR-1 transcript endpoint に投入する（AR-2）",
