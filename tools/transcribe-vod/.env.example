# transcribe-vod（AR-2）の設定。このファイルをコピーして .env を作り、値を記入する。
#   cp .env.example .env
# .env は gitignore 済み（値はコミットしない）。

# ElevenLabs Scribe v2 の API キー。
ELEVENLABS_API_KEY=

# AR-1 transcript endpoint の管理者トークン（apps/api の ADMIN_INGEST_TOKEN と一致させる）。
ADMIN_INGEST_TOKEN=

# apps/api のベース URL（末尾スラッシュなし）。
#   本番: https://fresh-chat-keeper-api.playnicelab.workers.dev
#   ローカル: http://localhost:8788
FCK_API_BASE=
