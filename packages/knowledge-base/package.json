{
  "name": "@fresh-chat-keeper/knowledge-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./data/*": "./data/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "validate": "node --input-type=module < scripts/validate.mjs",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/delacunaworks/fresh-chat-keeper.git"
  },
  "bugs": {
    "url": "https://github.com/delacunaworks/fresh-chat-keeper/issues"
  },
  "homepage": "https://github.com/delacunaworks/fresh-chat-keeper#readme",
  "dependencies": {
    "@fresh-chat-keeper/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
